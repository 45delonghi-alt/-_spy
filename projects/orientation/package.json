{
  "name": "orientation-spy-mission",
  "version": "1.0.0",
  "description": "1日仕事体験オリエンテーション動画【スパイ・ミッション演出版】",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.536",
    "@remotion/eslint-config-flat": "4.0.536",
    "@remotion/renderer": "^4.0.536",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "narration": "node scripts/generate-narration.mjs",
    "narration:ondoku": "node scripts/generate-narration.mjs --engine ondoku",
    "sfx": "bash scripts/generate-sfx.sh",
    "docs": "node scripts/export-docs.mjs",
    "stills": "node scripts/render-stills.mjs ../../docs/frames",
    "render:draft": "remotion render Orientation out/draft_540p.mp4 --scale=0.5 --crf=28",
    "render": "remotion render Orientation ../../output_final/orientation_spy_mission_1080p.mp4 --crf=20 --audio-codec=aac --audio-bitrate=192k"
  },
  "allowScripts": {
    "esbuild": false
  }
}
